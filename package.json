{
  "name": "communityconnect",
  "version": "1.0.0",
  "description": "CommunityConnect hackathon MVP app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --runInBand",
    "test:component": "jest tests/component --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,scss,json,md}\"",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "keywords": [
    "community",
    "volunteering",
    "hackathon",
    "expo",
    "mobile"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.1.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "^57.0.22",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.13",
    "expo-router": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "uuid": "^11.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "^57.0.11",
    "expo-modules-core": "^57.0.13",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
